{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    // --- ESTA ES LA LÍNEA CLAVE QUE SOLUCIONA LOS ERRORES DE 'PROMISE' ---
    "lib": ["ES2020", "DOM", "DOM.Iterable"]
  }
}
